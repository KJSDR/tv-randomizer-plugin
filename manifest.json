{
  "manifest_version": 3,
  "name": "TV Randomizer",
  "version": "0.1.0",
  "description": "Shuffle episodes across your chosen shows.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["shared/shuffle.js", "content/netflix.js"]
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content/netflix-page.js"],
      "world": "MAIN"
    }
  ]
}
